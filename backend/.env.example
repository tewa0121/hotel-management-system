PORT=5000
NODE_ENV=development

# MAMP MySQL (default MAMP port is 8889, default user/password is root/root)
DB_HOST=localhost
DB_PORT=8889
DB_USER=root
DB_PASSWORD=root
DB_NAME=hotel_management

# Use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=1d

# Frontend URL allowed by CORS (Vite runs on 3000 in this project)
CLIENT_URL=http://localhost:3000

# Seeding
# development: demo accounts and sample data are created automatically on an empty database.
# production : nothing is seeded except ONE admin built from the 3 values below.
# Set SEED_DEMO_DATA=true only for a public portfolio demo (demo passwords are public!).
SEED_DEMO_DATA=false
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mailtrap sandbox (create your own credentials at mailtrap.io)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASS=your_mailtrap_password
EMAIL_FROM=Hotel Management System <noreply@hotel.com>